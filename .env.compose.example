# Host path to a generated krx-rule-markdown corpus.
KRX_RULE_DATA_DIR=/opt/krx-rule-data

# Host path containing `current` and immutable BM25/vector generations.
# Use this repository's ./index when it matches the corpus, or a generated index directory.
KRX_RULE_INDEX_DIR=/opt/krx-rule-index

# HTTP bearer authentication is required by default. The directory must contain
# bearer-tokens.yaml in the documented version-1 registry format.
RULE_MCP_AUTH_MODE=required
RULE_MCP_AUTH_CONFIG_DIR=/opt/krx-rule-mcp-auth

# Production releases should set both values from the GHCR publish workflow.
# RULE_MCP_IMAGE=ghcr.io/chromato99/krx-rule-mcp@sha256:<manifest-digest>
# RULE_MCP_SERVER_IMAGE_DIGEST=sha256:<manifest-digest>

# Optional host ports.
RULE_MCP_PORT=8080
RULE_MCP_TEI_PORT=18081
# RULE_MCP_RERANKER_PORT=18082

# Required user selection. Choose a TEI image compatible with your target
# architecture and pin its immutable digest. krx-rule-mcp does not select one.
RULE_MCP_TEI_IMAGE=
RULE_MCP_TEI_IMAGE_DIGEST=
# Example shape only:
# RULE_MCP_TEI_IMAGE=registry.example/tei@sha256:<manifest-digest>
# RULE_MCP_TEI_IMAGE_DIGEST=sha256:<manifest-digest>

# Default repository vector index / TEI model. The same revision and embedding
# settings must be used when generating the vector index.
# RULE_MCP_TEI_MODEL_ID=intfloat/multilingual-e5-small
# KRX_EMBEDDING_MODEL=intfloat/multilingual-e5-small
KRX_EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# KRX_EMBEDDING_DIMENSIONS=384
# compose.yaml defaults prefixes to "query: " and "passage: ". Release
# deployments use this pinned E5 contract only. A different model, prefix, or
# structured-v1 input is research-only and is rejected by the release gate.
KRX_EMBEDDING_INPUT_FORMAT=text-v1

# The indexer submits 32 texts per embeddings request. TEI counts each input
# against this permit limit, so keep it at least 32 during vector builds.
# RULE_MCP_TEI_MAX_CONCURRENT_REQUESTS=64

# Optional Korean evidence reranker. Start its profile first, then enable the
# required policy for the MCP service:
#   docker compose --profile reranker up -d krx-rule-reranker
#   docker compose up -d krx-rule-mcp
# KRX_RERANKER_ENABLED=true
# KRX_RERANKER_POLICY=required
# KRX_REQUIRE_RERANKER=true
# KRX_RERANKER_MODEL=dragonkue/bge-reranker-v2-m3-ko
# KRX_RERANKER_MODEL_REVISION=2aca5884ecac490192af9ebd86836d9073d826cd
# KRX_RERANKER_CANDIDATE_LIMIT=20
# KRX_RERANKER_BATCH_SIZE=4
# RULE_MCP_RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
# RULE_MCP_RERANKER_IMAGE_DIGEST=sha256:<manifest-digest>
